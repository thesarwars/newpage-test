# ─── Anthropic ────────────────────────────────────────────────────────────────
# OPTIONAL. Without it the app runs in keyless mode: the entire deterministic
# pipeline (parse, chunk, embed, retrieve, cite, score, gap-analyse) runs live on
# your own uploads; only free-text generation is stubbed. See docs/PLAN.md §14.
ANTHROPIC_API_KEY=

# ─── Django ───────────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.dev
# Left blank on purpose. `make up` generates a random value into .env, which is
# gitignored. Nothing password-shaped is committed to this repository — see the
# "Secrets" note in the README.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
# host.docker.internal is how the browser inside the Playwright container
# reaches this API. Django rejects an unlisted Host with a 400 before any view
# runs, and the message names ALLOWED_HOSTS — but the browser only reports a
# failed request, so it surfaces as an app that will not load.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api,host.docker.internal
# Every origin the app is legitimately loaded from. An origin outside this list
# gets no CORS headers at all, so the browser drops the session cookie and every
# request arrives anonymous — which surfaces as a workspace that never loads,
# not as a CORS error the user can see. host.docker.internal is how the browser
# inside the Playwright container reaches the stack.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://host.docker.internal:3000

# console | json. Explicit rather than derived from DJANGO_DEBUG, because
# settings modules override DEBUG after import and a derived value ignores them.
# Defaults to console when DJANGO_DEBUG is true, json otherwise.
LOG_FORMAT=console

# ─── Postgres ─────────────────────────────────────────────────────────────────
POSTGRES_DB=cia
POSTGRES_USER=cia
# Blank on purpose — generated by `make up`, same as DJANGO_SECRET_KEY above.
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ─── LLM ──────────────────────────────────────────────────────────────────────
CIA_CHAT_MODEL=claude-opus-5
# auto = use Anthropic when a key is present, otherwise the keyless stub
LLM_BACKEND=auto
# Protects your API key. Checked against summed LLMCall.cost_usd over a rolling
# 24 hours — global, not per session, because a per-session cap is bypassed by
# looping sessions and the cookie is free.
LLM_DAILY_COST_CEILING_USD=10.00
# low | medium | high. Not a length control — opus-5 writes long by default and
# effort does not reliably shorten visible output; the system prompt does that.
CIA_CHAT_EFFORT=medium
# Artificial per-token delay for the keyless stub, so a demo answer streams
# visibly instead of arriving whole. 0 in tests.
LLM_FAKE_DELAY_S=0.012

# ─── Rate limits ──────────────────────────────────────────────────────────────
# Per session, not per IP: an IP key throttles a shared office NAT as one user
# and does nothing against a client that rotates addresses. Two windows on chat
# because one is always the wrong shape — 20/min alone permits 1,200 an hour.
THROTTLE_CHAT_BURST=20/min
THROTTLE_CHAT_SUSTAINED=60/hour
THROTTLE_UPLOAD=20/hour

# ─── Embeddings ───────────────────────────────────────────────────────────────
# local = bge-small-en-v1.5 via ONNX, no key, no network at runtime
EMBEDDING_BACKEND=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ─── Frontend ─────────────────────────────────────────────────────────────────
# Left blank on purpose. The client derives the API host from the hostname the
# page was served from (frontend/lib/api.ts), so it works at localhost, at
# 127.0.0.1, from another machine on the LAN, and from the browser inside the
# Playwright container. Pinning it to localhost breaks every one of those except
# the first — and it fails as "can't reach the API", not as a config error.
# Set it explicitly only when the API really is on a different host or port.
NEXT_PUBLIC_API_BASE_URL=
