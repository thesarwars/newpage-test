# ─── Anthropic ────────────────────────────────────────────────────────────────
# OPTIONAL. Without it the app runs in keyless mode: the entire deterministic
# pipeline (parse, chunk, embed, retrieve, cite, score, gap-analyse) runs live on
# your own uploads; only free-text generation is stubbed. See docs/PLAN.md §14.
ANTHROPIC_API_KEY=

# ─── Django ───────────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=dev-insecure-not-for-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
CORS_ALLOWED_ORIGINS=http://localhost:3000

# console | json. Explicit rather than derived from DJANGO_DEBUG, because
# settings modules override DEBUG after import and a derived value ignores them.
# Defaults to console when DJANGO_DEBUG is true, json otherwise.
LOG_FORMAT=console

# ─── Postgres ─────────────────────────────────────────────────────────────────
POSTGRES_DB=cia
POSTGRES_USER=cia
POSTGRES_PASSWORD=cia
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ─── LLM ──────────────────────────────────────────────────────────────────────
CIA_CHAT_MODEL=claude-opus-5
# auto = use Anthropic when a key is present, otherwise the keyless stub
LLM_BACKEND=auto
# Protects your API key. Checked against summed LLMCall.cost_usd.
LLM_DAILY_COST_CEILING_USD=10.00

# ─── Embeddings ───────────────────────────────────────────────────────────────
# local = bge-small-en-v1.5 via ONNX, no key, no network at runtime
EMBEDDING_BACKEND=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ─── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
